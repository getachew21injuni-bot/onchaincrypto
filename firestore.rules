rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && (request.auth.token.admin == true || (request.auth.token.email_verified == true && request.auth.token.email in ['getachew21.INJ.UNI@gmail.com', 'getachew21.inj.uni@gmail.com'])); }

    // Each member may read and update only their own profile.
    match /users/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.adminAssigned == true
        && request.resource.data.keys().hasOnly([
          'uid','adminAssigned','email','phoneNumber','phone','firstName','lastName','displayName','referralCode','referredByCode',
          'country','dateOfBirth','gender','address','createdAt','updatedAt'
        ]);
      allow update: if (
        owns(uid) && request.resource.data.uid == uid
        && request.resource.data.adminAssigned == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'adminAssigned','email','phoneNumber','phone','firstName','lastName','displayName','referralCode','referredByCode','country','dateOfBirth','gender','address','createdAt','updatedAt'
        ])
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminAssigned','demoBalanceUSDT','demoBalanceUpdatedAt','demoAssetBalances','demoAssetBalancesUpdatedAt','demoAssetBalancesUpdatedBy','demoWalletResetAt','demoWalletResetBy','adminUpdatedAt','adminUpdatedBy','accountStatus','tradingEnabled','maxTradeAmountUSDT','tradeControlUpdatedAt','tradeControlUpdatedBy'])
        && (!('adminAssigned' in request.resource.data) || request.resource.data.adminAssigned == true)
        && (!('demoBalanceUSDT' in request.resource.data) || (request.resource.data.demoBalanceUSDT is number && request.resource.data.demoBalanceUSDT >= 0 && request.resource.data.demoBalanceUSDT <= 1000000000))
        && (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus in ['active','suspended'])
        && (!('tradingEnabled' in request.resource.data) || request.resource.data.tradingEnabled is bool)
        && (!('maxTradeAmountUSDT' in request.resource.data) || (request.resource.data.maxTradeAmountUSDT is number && request.resource.data.maxTradeAmountUSDT >= 100 && request.resource.data.maxTradeAmountUSDT <= 1000000))
        && (!('tradeControlUpdatedBy' in request.resource.data) || request.resource.data.tradeControlUpdatedBy == request.auth.token.email)
        && (!('demoAssetBalances' in request.resource.data) || request.resource.data.demoAssetBalances is map)
        && (!('demoAssetBalancesUpdatedBy' in request.resource.data) || request.resource.data.demoAssetBalancesUpdatedBy == request.auth.token.email)
        && (!('demoWalletResetBy' in request.resource.data) || request.resource.data.demoWalletResetBy == request.auth.token.email)
        && (!('adminUpdatedBy' in request.resource.data) || request.resource.data.adminUpdatedBy == request.auth.token.email)
      );
      allow delete: if false;
    }


    // Admin-issued simulated coin credits/debits. Users can only read their own
    // entries; only a verified administrator can create ledger records.
    match /demoAssetTransactions/{transactionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'uid','type','asset','amount','balanceBefore','balanceAfter',
          'createdAt','createdAtText','createdBy','note','source','status'
        ])
        && request.resource.data.uid is string
        && request.resource.data.type in ['deposit','withdrawal']
        && request.resource.data.asset is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000000
        && request.resource.data.balanceBefore is number
        && request.resource.data.balanceAfter is number
        && request.resource.data.balanceAfter >= 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.source == 'admin-demo'
        && request.resource.data.status == 'completed';
      // Permit the admin to archive deposit rows from the history view only.
      allow update: if isAdmin()
        && resource.data.type == 'deposit'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminHiddenFromHistory','historyClearedAt','historyClearedBy'])
        && request.resource.data.adminHiddenFromHistory == true
        && request.resource.data.historyClearedBy == request.auth.token.email;
      allow delete: if false;
    }

    match /demoTransactions/{transactionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid','type','amountUSDT','balanceBeforeUSDT','balanceAfterUSDT','createdAt','createdAtText','createdBy','note','source','status'])
        && request.resource.data.uid is string
        && request.resource.data.type in ['deposit','withdrawal']
        && request.resource.data.amountUSDT is number
        && request.resource.data.amountUSDT > 0
        && request.resource.data.amountUSDT <= 1000000000
        && request.resource.data.balanceBeforeUSDT is number
        && request.resource.data.balanceAfterUSDT is number
        && request.resource.data.balanceAfterUSDT >= 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.source == 'admin-demo'
        && request.resource.data.status == 'completed';
      // Permit the admin to archive deposit rows from the history view only.
      allow update: if isAdmin()
        && resource.data.type == 'deposit'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminHiddenFromHistory','historyClearedAt','historyClearedBy'])
        && request.resource.data.adminHiddenFromHistory == true
        && request.resource.data.historyClearedBy == request.auth.token.email;
      allow delete: if false;
    }

    // Members may submit/read their own KYC details. They cannot set an
    // approved/rejected status themselves. Review status changes require
    // a trusted Admin SDK backend or an admin custom claim.
    match /kycSubmissions/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'uid','email','legalName','country','documentType','documentNumber',
          'status','submittedAt','updatedAt'
        ]);
      allow update: if (
        owns(uid)
        && resource.data.status in ['pending','rejected']
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'uid','email','legalName','country','documentType','documentNumber',
          'status','submittedAt','updatedAt','reviewedAt','reviewedBy'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email','legalName','country','documentType','documentNumber',
          'status','submittedAt','updatedAt'
        ])
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','reviewedAt','reviewedBy','updatedAt'
        ])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedBy == request.auth.token.email
      );
      allow delete: if false;
    }

    // Private in-app notifications; only verified admins can issue notifications.
    match /userNotifications/{uid}/items/{notificationId} {
      allow read: if owns(uid) || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['kind','title','message','createdAt','createdAtText','readAt','createdBy','source'])
        && request.resource.data.kind in ['kyc_approved','kyc_rejected','deposit','withdrawal']
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.createdBy == request.auth.uid
        && (!('source' in request.resource.data) || request.resource.data.source == 'admin-demo');
      allow update: if owns(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) && request.resource.data.readAt != null;
      allow delete: if owns(uid);
    }

    // Private customer-support conversations.
    match /supportTickets/{ticketId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['ownerUid','customerEmail','customerName','subject','status','createdAt','updatedAt','lastMessage','source'])
        && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 100;
      allow get, list: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','lastMessage']) && request.resource.data.status in ['open','in_progress','resolved']) || (signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','lastMessage']));
      allow delete: if false;
      match /messages/{messageId} {
        function ticketOwner() { return signedIn() && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.ownerUid == request.auth.uid; }
        allow read: if isAdmin() || ticketOwner();
        allow create: if (isAdmin() && request.resource.data.senderUid == request.auth.uid && request.resource.data.senderRole == 'admin')
          || (ticketOwner() && request.resource.data.senderUid == request.auth.uid && request.resource.data.senderRole == 'customer');
        allow update, delete: if false;
      }
    }


    // Public receiving-wallet instructions. Only the verified administrator
    // can publish or change coin/network addresses; users may read them.
    match /walletAddresses/{walletAddressId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'asset','network','depositAddress','qrCodeUrl','withdrawalAddress',
          'depositEnabled','withdrawalEnabled','updatedAt','updatedBy'
        ])
        && request.resource.data.asset is string
        && request.resource.data.asset.size() > 0
        && request.resource.data.asset.size() <= 20
        && request.resource.data.network is string
        && request.resource.data.network.size() > 0
        && request.resource.data.network.size() <= 50
        && request.resource.data.depositAddress is string
        && request.resource.data.depositAddress.size() <= 500
        && request.resource.data.qrCodeUrl is string
        && request.resource.data.qrCodeUrl.size() <= 500000
        && request.resource.data.withdrawalAddress is string
        && request.resource.data.withdrawalAddress.size() <= 500
        && request.resource.data.depositEnabled is bool
        && request.resource.data.withdrawalEnabled is bool
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if isAdmin();
    }

    // Shared demo trade mode. Every signed-in user can read the published mode;
    // only the verified administrator can change it.
    match /platformSettings/{settingId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && settingId == 'demoTradeControl'
        && request.resource.data.keys().hasOnly(['mode','updatedAt','updatedBy'])
        && request.resource.data.mode in ['market','win','lose']
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if false;
    }


    // Deposit request submission and review. Approval is not a balance credit.
    match /depositRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid','email','asset','network','amount','depositAddress','transactionHash','receiptImage','receiptFileName','status','createdAt'])
        && request.resource.data.asset is string && request.resource.data.network is string
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000000
        && request.resource.data.depositAddress is string && request.resource.data.depositAddress.size() > 0
        && request.resource.data.transactionHash is string && request.resource.data.transactionHash.size() >= 8 && request.resource.data.transactionHash.size() <= 180
        && request.resource.data.receiptImage is string && request.resource.data.receiptImage.size() <= 760000
        && request.resource.data.receiptImage.matches('^data:image/jpeg;base64,.*')
        && request.resource.data.receiptFileName is string && request.resource.data.receiptFileName.size() <= 120;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() && (
        (resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
          && request.resource.data.status in ['approved','rejected']
          && request.resource.data.reviewedBy == request.auth.token.email)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminHiddenFromHistory','historyClearedAt','historyClearedBy'])
          && request.resource.data.adminHiddenFromHistory == true
          && request.resource.data.historyClearedBy == request.auth.token.email)
      );
      allow delete: if false;
    }
    // Withdrawal request submission and review. A separate payout process is required.
    match /withdrawRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid','email','asset','network','amount','destinationAddress','status','createdAt'])
        && request.resource.data.asset is string && request.resource.data.network is string
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000000
        && request.resource.data.destinationAddress is string && request.resource.data.destinationAddress.size() >= 10 && request.resource.data.destinationAddress.size() <= 500;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedBy == request.auth.token.email;
      allow delete: if false;
    }

    match /brokerConnectionRequests/{uid} {
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.provider == 'Alpaca Broker API'
        && request.resource.data.reviewStatus == 'pending'
        && request.resource.data.keys().hasOnly(['uid','email','fullName','provider','reviewStatus','createdAt']);
      allow get: if owns(uid) || isAdmin();
      allow list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus','adminNote','reviewedAt','reviewedBy'])
        && request.resource.data.reviewStatus in ['pending','reviewing','eligible','needs_info','rejected']
        && request.resource.data.adminNote is string
        && request.resource.data.adminNote.size() <= 300
        && request.resource.data.reviewedBy == request.auth.token.email;
      allow delete: if false;
    }

    match /adminHistoryClearLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.kind == 'deposit-history'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.source == 'admin-dashboard';
      allow update, delete: if false;
    }
    match /adminWalletResetLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.uid is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.afterUSDT == 0
        && request.resource.data.source == 'admin-dashboard';
      allow update, delete: if false;
    }

    // All other collections remain closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
})
        && request.resource.data.receiptFileName is string && request.resource.data.receiptFileName.size() <= 120;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() && (
        (resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
          && request.resource.data.status in ['approved','rejected']
          && request.resource.data.reviewedBy == request.auth.token.email)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminHiddenFromHistory','historyClearedAt','historyClearedBy'])
          && request.resource.data.adminHiddenFromHistory == true
          && request.resource.data.historyClearedBy == request.auth.token.email)
      );
      allow delete: if false;
    }
    // Withdrawal request submission and review. A separate payout process is required.
    match /withdrawRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid','email','asset','network','amount','destinationAddress','status','createdAt'])
        && request.resource.data.asset is string && request.resource.data.network is string
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000000
        && request.resource.data.destinationAddress is string && request.resource.data.destinationAddress.size() >= 10 && request.resource.data.destinationAddress.size() <= 500;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedBy == request.auth.token.email;
      allow delete: if false;
    }

    match /brokerConnectionRequests/{uid} {
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.provider == 'Alpaca Broker API'
        && request.resource.data.reviewStatus == 'pending'
        && request.resource.data.keys().hasOnly(['uid','email','fullName','provider','reviewStatus','createdAt']);
      allow get: if owns(uid) || isAdmin();
      allow list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus','adminNote','reviewedAt','reviewedBy'])
        && request.resource.data.reviewStatus in ['pending','reviewing','eligible','needs_info','rejected']
        && request.resource.data.adminNote is string
        && request.resource.data.adminNote.size() <= 300
        && request.resource.data.reviewedBy == request.auth.token.email;
      allow delete: if false;
    }

    match /adminHistoryClearLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.kind == 'deposit-history'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.source == 'admin-dashboard';
      allow update, delete: if false;
    }
    match /adminWalletResetLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.uid is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.afterUSDT == 0
        && request.resource.data.source == 'admin-dashboard';
      allow update, delete: if false;
    }

    // All other collections remain closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}