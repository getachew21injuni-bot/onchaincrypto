rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && (request.auth.token.get('admin', false) == true || (request.auth.token.get('email_verified', false) == true && request.auth.token.get('email', '') in ['getachew21.INJ.UNI@gmail.com', 'getachew21.inj.uni@gmail.com'])); }

    // Per-account trading state and results. This is an account-specific
    // platform ledger snapshot, separate from admin-controlled deposit credits.
    match /userTradeState/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create, update: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','balance','holdings','history','updatedAt'])
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && request.resource.data.balance <= 1000000000
        && request.resource.data.holdings is map
        && request.resource.data.history is list
        && request.resource.data.history.size() <= 300;
      allow delete: if false;
    }

    // Each member may read and update only their own profile.
    match /users/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.adminAssigned == true
        && request.resource.data.keys().hasOnly([
          'uid','adminAssigned','email','phoneNumber','phone','firstName','lastName','displayName','referralCode','referredByCode',
          'country','dateOfBirth','gender','address','avatarDataUrl','createdAt','updatedAt'
        ])
        && (!('avatarDataUrl' in request.resource.data) || (request.resource.data.avatarDataUrl is string && request.resource.data.avatarDataUrl.size() <= 160000));
      allow update: if (
        owns(uid) && request.resource.data.uid == uid
        && request.resource.data.adminAssigned == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'adminAssigned','email','phoneNumber','phone','firstName','lastName','displayName','referralCode','referredByCode','country','dateOfBirth','gender','address','avatarDataUrl','createdAt','updatedAt'
        ])
        && (!('avatarDataUrl' in request.resource.data) || (request.resource.data.avatarDataUrl is string && request.resource.data.avatarDataUrl.size() <= 160000))
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminAssigned','demoBalanceUSDT','demoBalanceUpdatedAt','demoAssetBalances','demoAssetBalancesUpdatedAt','demoAssetBalancesUpdatedBy','demoWalletResetAt','demoWalletResetBy','demoBalanceLastTransferId','adminUpdatedAt','adminUpdatedBy','accountStatus','tradingEnabled','maxTradeAmountUSDT','demoTradeControlMode','demoWinPercent','demoLossPercent','tradeControlUpdatedAt','tradeControlUpdatedBy'])
        && (!('adminAssigned' in request.resource.data) || request.resource.data.adminAssigned == true)
        && (!('demoBalanceUSDT' in request.resource.data) || (request.resource.data.demoBalanceUSDT is number && request.resource.data.demoBalanceUSDT >= 0 && request.resource.data.demoBalanceUSDT <= 1000000000))
        && (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus in ['active','suspended'])
        && (!('tradingEnabled' in request.resource.data) || request.resource.data.tradingEnabled is bool)
        && (!('maxTradeAmountUSDT' in request.resource.data) || (request.resource.data.maxTradeAmountUSDT is number && request.resource.data.maxTradeAmountUSDT >= 100 && request.resource.data.maxTradeAmountUSDT <= 1000000))
        && (!('demoTradeControlMode' in request.resource.data) || request.resource.data.demoTradeControlMode in ['inherit','market','win','lose'])
        && (!('demoWinPercent' in request.resource.data) || (request.resource.data.demoWinPercent is int && request.resource.data.demoWinPercent >= 1 && request.resource.data.demoWinPercent <= 100))
        && (!('demoLossPercent' in request.resource.data) || (request.resource.data.demoLossPercent is int && request.resource.data.demoLossPercent >= 1 && request.resource.data.demoLossPercent <= 100))
        && (!('tradeControlUpdatedBy' in request.resource.data) || request.resource.data.tradeControlUpdatedBy == request.auth.token.email)
        && (!('demoAssetBalances' in request.resource.data) || request.resource.data.demoAssetBalances is map)
        && (!('demoAssetBalancesUpdatedBy' in request.resource.data) || request.resource.data.demoAssetBalancesUpdatedBy == request.auth.token.email)
        && (!('demoWalletResetBy' in request.resource.data) || request.resource.data.demoWalletResetBy == request.auth.token.email)
        && (!('adminUpdatedBy' in request.resource.data) || request.resource.data.adminUpdatedBy == request.auth.token.email)
      );
      allow delete: if false;
    }


    // Admin-issued simulated coin credits/debits. Users can only read their own
    // entries; only a verified administrator can create ledger records.
    match /demoAssetTransactions/{transactionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'uid','type','asset','amount','balanceBefore','balanceAfter',
          'createdAt','createdAtText','createdBy','note','source','status'
        ])
        && request.resource.data.uid is string
        && request.resource.data.type in ['deposit','withdrawal']
        && request.resource.data.asset is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000000
        && request.resource.data.balanceBefore is number
        && request.resource.data.balanceAfter is number
        && request.resource.data.balanceAfter >= 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.source == 'admin-demo'
        && request.resource.data.status == 'completed';
      // Permit the admin to archive deposit rows from the history view only.
      allow update: if isAdmin()
        && resource.data.type == 'deposit'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminHiddenFromHistory','historyClearedAt','historyClearedBy'])
        && request.resource.data.adminHiddenFromHistory == true
        && request.resource.data.historyClearedBy == request.auth.token.email;
      allow delete: if false;
    }

    match /demoTransactions/{transactionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid','type','amountUSDT','balanceBeforeUSDT','balanceAfterUSDT','createdAt','createdAtText','createdBy','note','source','status'])
        && request.resource.data.uid is string
        && request.resource.data.type in ['deposit','withdrawal']
        && request.resource.data.amountUSDT is number
        && request.resource.data.amountUSDT > 0
        && request.resource.data.amountUSDT <= 1000000000
        && request.resource.data.balanceBeforeUSDT is number
        && request.resource.data.balanceAfterUSDT is number
        && request.resource.data.balanceAfterUSDT >= 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.source == 'admin-demo'
        && request.resource.data.status == 'completed';
      // Permit the admin to archive deposit rows from the history view only.
      allow update: if isAdmin()
        && resource.data.type == 'deposit'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminHiddenFromHistory','historyClearedAt','historyClearedBy'])
        && request.resource.data.adminHiddenFromHistory == true
        && request.resource.data.historyClearedBy == request.auth.token.email;
      allow delete: if false;
    }

    // Members may submit/read their own KYC details. They cannot set an
    // approved/rejected status themselves. Review status changes require
    // a trusted Admin SDK backend or an admin custom claim.
    match /kycSubmissions/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'uid','email','legalName','country','documentType','documentNumber',
          'status','submittedAt','updatedAt'
        ]);
      allow update: if (
        owns(uid)
        && resource.data.status in ['pending','rejected']
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'uid','email','legalName','country','documentType','documentNumber',
          'status','submittedAt','updatedAt','reviewedAt','reviewedBy'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email','legalName','country','documentType','documentNumber',
          'status','submittedAt','updatedAt'
        ])
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','reviewedAt','reviewedBy','updatedAt'
        ])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedBy == request.auth.token.email
      );
      allow delete: if false;
    }

    // Private in-app notifications; only verified admins can issue notifications.
    match /userNotifications/{uid}/items/{notificationId} {
      allow read: if owns(uid) || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['kind','title','message','createdAt','createdAtText','readAt','createdBy','source'])
        && request.resource.data.kind in ['kyc_approved','kyc_rejected','deposit','withdrawal']
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.createdBy == request.auth.uid
        && (!('source' in request.resource.data) || request.resource.data.source == 'admin-demo');
      allow update: if owns(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) && request.resource.data.readAt != null;
      allow delete: if owns(uid);
    }

    // Private customer-support conversations.
    match /supportTickets/{ticketId} {
      allow create: if (
        signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['ownerUid','customerEmail','customerName','subject','status','createdAt','updatedAt','lastMessage','source'])
        && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 100
      ) || (
        isAdmin()
        && request.resource.data.ownerUid is string
        && exists(/databases/$(database)/documents/users/$(request.resource.data.ownerUid))
        && request.resource.data.status == 'open'
        && request.resource.data.source == 'admin-direct'
        && request.resource.data.keys().hasOnly(['ownerUid','customerEmail','customerName','subject','status','createdAt','updatedAt','lastMessage','source'])
        && request.resource.data.customerEmail is string && request.resource.data.customerEmail.size() <= 160
        && request.resource.data.customerName is string && request.resource.data.customerName.size() <= 100
        && request.resource.data.subject is string && request.resource.data.subject == 'Message from Onchain Support'
        && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() > 0 && request.resource.data.lastMessage.size() <= 3000
      );
      allow get, list: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','lastMessage']) && request.resource.data.status in ['open','in_progress','resolved']) || (signedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','lastMessage']));
      allow delete: if false;
      match /messages/{messageId} {
        function ticketOwner() { return signedIn() && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.ownerUid == request.auth.uid; }
        allow read: if isAdmin() || ticketOwner();
        allow create: if (isAdmin() && request.resource.data.senderUid == request.auth.uid && request.resource.data.senderRole == 'admin')
          || (ticketOwner() && request.resource.data.senderUid == request.auth.uid && request.resource.data.senderRole == 'customer');
        allow update, delete: if false;
      }
    }


    // Public receiving-wallet instructions. Only the verified administrator
    // can publish or change coin/network addresses; users may read them.
    match /walletAddresses/{walletAddressId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'asset','network','depositAddress','qrCodeUrl','withdrawalAddress',
          'depositEnabled','withdrawalEnabled','updatedAt','updatedBy'
        ])
        && request.resource.data.asset is string
        && request.resource.data.asset.size() > 0
        && request.resource.data.asset.size() <= 20
        && request.resource.data.network is string
        && request.resource.data.network.size() > 0
        && request.resource.data.network.size() <= 50
        && request.resource.data.depositAddress is string
        && request.resource.data.depositAddress.size() <= 500
        && request.resource.data.qrCodeUrl is string
        && request.resource.data.qrCodeUrl.size() <= 500000
        && request.resource.data.withdrawalAddress is string
        && request.resource.data.withdrawalAddress.size() <= 500
        && request.resource.data.depositEnabled is bool
        && request.resource.data.withdrawalEnabled is bool
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if isAdmin();
    }

    // Shared demo trade mode. Every signed-in user can read the published mode;
    // only the verified administrator can change it.
    match /platformSettings/{settingId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && (
        (settingId == 'demoTradeControl'
          && request.resource.data.keys().hasOnly(['mode','updatedAt','updatedBy'])
          && request.resource.data.mode in ['market','win','lose']
          && request.resource.data.updatedBy == request.auth.token.email)
        ||
        (settingId == 'marketAlertState'
          && request.resource.data.keys().hasOnly(['lastSentAtMs','lastKind','updatedAt','updatedBy'])
          && request.resource.data.lastSentAtMs is number
          && request.resource.data.lastKind in ['bullish','bearish']
          && request.resource.data.updatedBy == request.auth.token.email)
      );
      allow delete: if false;
    }

    // Shared market alerts are visible to signed-in members and published only
    // by the verified administrator. Alerts are append-only.
    match /marketAlerts/{alertId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'kind','title','message','createdAt','createdAtText',
          'createdBy','createdByEmail','source','basketMedian24h','assetCount'
        ])
        && request.resource.data.kind in ['bullish','bearish']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 8
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAtText is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.source in ['admin-manual','market-auto']
        && (!('basketMedian24h' in request.resource.data) || request.resource.data.basketMedian24h is number)
        && (!('assetCount' in request.resource.data) || request.resource.data.assetCount is int);
      allow update, delete: if false;
    }


    // Deposit request submission and review. Approval is not a balance credit.
    match /depositRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid','email','asset','network','amount','depositAddress','transactionHash','receiptImage','receiptFileName','status','createdAt'])
        && request.resource.data.asset is string && request.resource.data.network is string
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000000
        && request.resource.data.depositAddress is string && request.resource.data.depositAddress.size() > 0
        && request.resource.data.transactionHash is string && request.resource.data.transactionHash.size() >= 8 && request.resource.data.transactionHash.size() <= 180
        && request.resource.data.receiptImage is string && request.resource.data.receiptImage.size() <= 760000
        && request.resource.data.receiptImage.matches('^data:image/jpeg;base64,.*')
        && request.resource.data.receiptFileName is string && request.resource.data.receiptFileName.size() <= 120;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() && (
        (resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
          && request.resource.data.status in ['approved','rejected']
          && request.resource.data.reviewedBy == request.auth.token.email)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminHiddenFromHistory','historyClearedAt','historyClearedBy'])
          && request.resource.data.adminHiddenFromHistory == true
          && request.resource.data.historyClearedBy == request.auth.token.email)
      );
      allow delete: if false;
    }
    // Withdrawal request submission and review. A separate payout process is required.
    match /withdrawRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid','email','asset','network','amount','destinationAddress','status','createdAt'])
        && request.resource.data.asset is string && request.resource.data.network is string
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000000
        && request.resource.data.destinationAddress is string && request.resource.data.destinationAddress.size() >= 10 && request.resource.data.destinationAddress.size() <= 500;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedBy == request.auth.token.email;
      allow delete: if false;
    }

    // Minimal account directory: signed-in users can fetch a known OnChain ID,
    // but cannot list or enumerate other members.
    match /userDirectory/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['uid','displayName','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Customer-submitted USDT transfer requests. Requests never expose wallet balances.
    match /internalTransferRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['senderUid','recipientUid','asset','amount','senderName','recipientName','status','createdAt'])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && exists(/databases/$(database)/documents/userDirectory/$(request.resource.data.recipientUid))
        && request.resource.data.recipientName == get(/databases/$(database)/documents/userDirectory/$(request.resource.data.recipientUid)).data.displayName
        && exists(/databases/$(database)/documents/userDirectory/$(request.auth.uid))
        && request.resource.data.senderName == get(/databases/$(database)/documents/userDirectory/$(request.auth.uid)).data.displayName
        && request.resource.data.asset == 'USDT'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000000
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 80
        && request.resource.data.recipientName is string
        && request.resource.data.recipientName.size() <= 80
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow get, list: if isAdmin()
        || (signedIn() && (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid));
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy','transferId'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.token.email
        && (
          (request.resource.data.status == 'rejected' && !('transferId' in request.resource.data))
          || (
            request.resource.data.status == 'approved'
            && request.resource.data.transferId is string
            && getAfter(/databases/$(database)/documents/internalTransfers/$(request.resource.data.transferId)).data.transferRequestId == requestId
            && getAfter(/databases/$(database)/documents/internalTransfers/$(request.resource.data.transferId)).data.senderUid == resource.data.senderUid
            && getAfter(/databases/$(database)/documents/internalTransfers/$(request.resource.data.transferId)).data.recipientUid == resource.data.recipientUid
            && getAfter(/databases/$(database)/documents/internalTransfers/$(request.resource.data.transferId)).data.amount == resource.data.amount
          )
        );
      allow delete: if false;
    }

    // Immutable ledger. Only an administrator can approve a pending request;
    // both wallet updates, request status, and ledger must commit atomically.
    match /internalTransfers/{transferId} {
      allow get, list: if signedIn()
        && (isAdmin() || resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['senderUid','recipientUid','asset','amount','senderBefore','senderAfter','recipientBefore','recipientAfter','senderName','recipientName','createdAt','transferRequestId','approvedBy'])
        && request.resource.data.senderUid is string
        && request.resource.data.recipientUid is string
        && request.resource.data.senderUid != request.resource.data.recipientUid
        && request.resource.data.asset == 'USDT'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000000
        && request.resource.data.senderBefore is number
        && request.resource.data.senderAfter is number
        && request.resource.data.recipientBefore is number
        && request.resource.data.recipientAfter is number
        && request.resource.data.senderBefore >= request.resource.data.amount
        && request.resource.data.senderAfter == request.resource.data.senderBefore - request.resource.data.amount
        && request.resource.data.recipientAfter == request.resource.data.recipientBefore + request.resource.data.amount
        && request.resource.data.senderAfter >= 0
        && request.resource.data.recipientAfter <= 1000000000
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 80
        && request.resource.data.recipientName is string
        && request.resource.data.recipientName.size() <= 80
        && request.resource.data.transferRequestId is string
        && request.resource.data.approvedBy == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/internalTransferRequests/$(request.resource.data.transferRequestId)).data.status == 'pending'
        && get(/databases/$(database)/documents/internalTransferRequests/$(request.resource.data.transferRequestId)).data.senderUid == request.resource.data.senderUid
        && get(/databases/$(database)/documents/internalTransferRequests/$(request.resource.data.transferRequestId)).data.recipientUid == request.resource.data.recipientUid
        && get(/databases/$(database)/documents/internalTransferRequests/$(request.resource.data.transferRequestId)).data.amount == request.resource.data.amount
        && getAfter(/databases/$(database)/documents/internalTransferRequests/$(request.resource.data.transferRequestId)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/internalTransferRequests/$(request.resource.data.transferRequestId)).data.transferId == transferId
        && get(/databases/$(database)/documents/users/$(request.resource.data.senderUid)).data.get('demoBalanceUSDT', 0) == request.resource.data.senderBefore
        && get(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)).data.get('demoBalanceUSDT', 0) == request.resource.data.recipientBefore
        && get(/databases/$(database)/documents/users/$(request.resource.data.senderUid)).data.get('accountStatus', 'active') == 'active'
        && get(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)).data.get('accountStatus', 'active') == 'active'
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.senderUid)).data.demoBalanceUSDT == request.resource.data.senderAfter
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)).data.demoBalanceUSDT == request.resource.data.recipientAfter
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.senderUid)).data.demoBalanceLastTransferId == transferId
        && getAfter(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)).data.demoBalanceLastTransferId == transferId;
      allow update, delete: if false;
    }

    match /brokerConnectionRequests/{uid} {
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.provider == 'Alpaca Broker API'
        && request.resource.data.reviewStatus == 'pending'
        && request.resource.data.keys().hasOnly(['uid','email','fullName','provider','reviewStatus','createdAt']);
      allow get: if owns(uid) || isAdmin();
      allow list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus','adminNote','reviewedAt','reviewedBy'])
        && request.resource.data.reviewStatus in ['pending','reviewing','eligible','needs_info','rejected']
        && request.resource.data.adminNote is string
        && request.resource.data.adminNote.size() <= 300
        && request.resource.data.reviewedBy == request.auth.token.email;
      allow delete: if false;
    }

    // User-submitted account activity. Members can append only their own
    // limited event metadata; only verified administrators can read the feed.
    // Central user activity feed. Users may append only their own events;
    // only the designated administrator can read events across accounts.
    match /userActivityEvents/{eventId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','email','type','title','details','status','createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 180
        && request.resource.data.type in ['trade','deposit','withdraw','convert','transfer','page_view','watchlist','profile_update','kyc','support','activity']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 180
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && request.resource.data.status is string
        && request.resource.data.status.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if false;
    }

    match /adminActivityLogs/{logId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','email','eventType','device','browser','timezone','createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 180
        && request.resource.data.eventType in ['login','logout','registration','profile_update','kyc_submit','deposit_request','withdrawal_request','support_message']
        && request.resource.data.device in ['Mobile','Desktop']
        && request.resource.data.browser in ['Chrome','Firefox','Edge','Safari','Other']
        && request.resource.data.timezone is string
        && request.resource.data.timezone.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /adminHistoryClearLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.kind == 'deposit-history'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.source == 'admin-dashboard';
      allow update, delete: if false;
    }
    match /adminWalletResetLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.uid is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.afterUSDT == 0
        && request.resource.data.source == 'admin-dashboard';
      allow update, delete: if false;
    }

    // All other collections remain closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
