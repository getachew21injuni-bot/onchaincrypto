rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && (request.auth.token.admin == true || (request.auth.token.email_verified == true && request.auth.token.email in ['getachew21.INJ.UNI@gmail.com', 'getachew21.inj.uni@gmail.com'])); }

    // Each member may read and update only their own profile.
    match /users/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid','email','phoneNumber','phone','firstName','lastName','displayName','referralCode',
          'country','dateOfBirth','gender','address','createdAt','updatedAt'
        ]);
      allow update: if (
        owns(uid) && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email','phoneNumber','phone','firstName','lastName','displayName','referralCode','country','dateOfBirth','gender','address','createdAt','updatedAt'
        ])
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['demoBalanceUSDT','demoBalanceUpdatedAt','demoAssetBalances','demoAssetBalancesUpdatedAt','demoAssetBalancesUpdatedBy','adminUpdatedAt','adminUpdatedBy','accountStatus'])
        && (!('demoBalanceUSDT' in request.resource.data) || (request.resource.data.demoBalanceUSDT is number && request.resource.data.demoBalanceUSDT >= 0 && request.resource.data.demoBalanceUSDT <= 1000000000))
        && (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus in ['active','suspended'])
        && (!('demoAssetBalances' in request.resource.data) || request.resource.data.demoAssetBalances is map)
        && (!('demoAssetBalancesUpdatedBy' in request.resource.data) || request.resource.data.demoAssetBalancesUpdatedBy == request.auth.token.email)
        && (!('adminUpdatedBy' in request.resource.data) || request.resource.data.adminUpdatedBy == request.auth.token.email)
      );
      allow delete: if false;
    }


    // Admin-issued simulated coin credits/debits. Users can only read their own
    // entries; only a verified administrator can create ledger records.
    match /demoAssetTransactions/{transactionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'uid','type','asset','amount','balanceBefore','balanceAfter',
          'createdAt','createdAtText','createdBy','note','source','status'
        ])
        && request.resource.data.uid is string
        && request.resource.data.type in ['deposit','withdrawal']
        && request.resource.data.asset is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000000
        && request.resource.data.balanceBefore is number
        && request.resource.data.balanceAfter is number
        && request.resource.data.balanceAfter >= 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.source == 'admin-demo'
        && request.resource.data.status == 'completed';
      allow update, delete: if false;
    }

    match /demoTransactions/{transactionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid','type','amountUSDT','balanceBeforeUSDT','balanceAfterUSDT','createdAt','createdAtText','createdBy','note','source','status'])
        && request.resource.data.uid is string
        && request.resource.data.type in ['deposit','withdrawal']
        && request.resource.data.amountUSDT is number
        && request.resource.data.amountUSDT > 0
        && request.resource.data.amountUSDT <= 1000000000
        && request.resource.data.balanceBeforeUSDT is number
        && request.resource.data.balanceAfterUSDT is number
        && request.resource.data.balanceAfterUSDT >= 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.source == 'admin-demo'
        && request.resource.data.status == 'completed';
      allow update, delete: if false;
    }

    // Members may submit/read their own KYC details. They cannot set an
    // approved/rejected status themselves. Review status changes require
    // a trusted Admin SDK backend or an admin custom claim.
    match /kycSubmissions/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'uid','email','legalName','country','documentType','documentNumber',
          'status','submittedAt','updatedAt'
        ]);
      allow update: if (
        owns(uid)
        && resource.data.status in ['pending','rejected']
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'uid','email','legalName','country','documentType','documentNumber',
          'status','submittedAt','updatedAt','reviewedAt','reviewedBy'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email','legalName','country','documentType','documentNumber',
          'status','submittedAt','updatedAt'
        ])
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','reviewedAt','reviewedBy','updatedAt'
        ])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedBy == request.auth.token.email
      );
      allow delete: if false;
    }

    // Private in-app notifications; only verified admins can issue notifications.
    match /userNotifications/{uid}/items/{notificationId} {
      allow read: if owns(uid) || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['kind','title','message','createdAt','createdAtText','readAt','createdBy','source'])
        && request.resource.data.kind in ['kyc_approved','kyc_rejected','deposit','withdrawal']
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.createdBy == request.auth.uid
        && (!('source' in request.resource.data) || request.resource.data.source == 'admin-demo');
      allow update: if owns(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) && request.resource.data.readAt != null;
      allow delete: if owns(uid);
    }

    // Private customer-support conversations.
    match /supportTickets/{ticketId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['ownerUid','customerEmail','customerName','subject','status','createdAt','updatedAt','lastMessage'])
        && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 100;
      allow get, list: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','lastMessage']) && request.resource.data.status in ['open','in_progress','resolved'];
      allow delete: if false;
      match /messages/{messageId} {
        function ticketOwner() { return signedIn() && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.ownerUid == request.auth.uid; }
        allow read: if isAdmin() || ticketOwner();
        allow create: if (isAdmin() && request.resource.data.senderUid == request.auth.uid && request.resource.data.senderRole == 'admin')
          || (ticketOwner() && request.resource.data.senderUid == request.auth.uid && request.resource.data.senderRole == 'customer');
        allow update, delete: if false;
      }
    }


    // Public receiving-wallet instructions. Only the verified administrator
    // can publish or change coin/network addresses; users may read them.
    match /walletAddresses/{walletAddressId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'asset','network','depositAddress','qrCodeUrl','withdrawalAddress',
          'depositEnabled','withdrawalEnabled','updatedAt','updatedBy'
        ])
        && request.resource.data.asset is string
        && request.resource.data.asset.size() > 0
        && request.resource.data.asset.size() <= 20
        && request.resource.data.network is string
        && request.resource.data.network.size() > 0
        && request.resource.data.network.size() <= 50
        && request.resource.data.depositAddress is string
        && request.resource.data.depositAddress.size() <= 500
        && request.resource.data.qrCodeUrl is string
        && request.resource.data.qrCodeUrl.size() <= 500000
        && request.resource.data.withdrawalAddress is string
        && request.resource.data.withdrawalAddress.size() <= 500
        && request.resource.data.depositEnabled is bool
        && request.resource.data.withdrawalEnabled is bool
        && request.resource.data.updatedBy == request.auth.token.email;
      allow delete: if isAdmin();
    }

    // All other collections remain closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}