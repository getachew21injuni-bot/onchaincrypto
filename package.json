{
  "name": "onchaincrypto-wallet-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/firestore.rules.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-onchaincrypto-rules-test --only firestore \"npm test\"",
    "test:reconciliation": "node --check workers/wallet-api/index.js && node --test tests/wallet-reconciliation.test.mjs tests/wallet-worker-static.test.mjs",
    "check:wallet-api-v2": "node --check workers/wallet-api-v2/index.js",
    "test:wallet-api-v2": "node --check workers/wallet-api-v2/index.js && node --test tests/wallet-api-v2.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.0.0"
  }
}
